<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".MainActivity">

        <TextView
            android:id="@+id/MAD_Pr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MAD_Animation_Practical"
            android:textSize="25sp"
            android:layout_margin="15dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

        </TextView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            app:cardCornerRadius="15dp"
            app:cardElevation="20dp"
            android:backgroundTint="#F0F2FF"
            app:layout_constraintTop_toBottomOf="@id/MAD_Pr">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp">

                <ImageView
                    android:id="@+id/img1"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:scaleType="fitXY"
                    app:layout_constraintTop_toTopOf="parent">

                </ImageView>

                <TextView
                    android:id="@+id/txt1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:text="Create Alarm Time"
                    android:textSize="20dp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toBottomOf="@id/img1">

                </TextView>

                <TextView
                    android:id="@+id/txt2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:textColor="#616161"
                    android:textSize="15dp"
                    android:text="By pressing buttons, Alarm can be created and cancelled."
                    app:layout_constraintTop_toBottomOf="@id/txt1">

                </TextView>

                <TextView
                    android:id="@+id/txt3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:textColor="#616161"
                    android:textSize="15sp"
                    android:text="Check Current time by looking below real digital clock."
                    app:layout_constraintTop_toBottomOf="@id/txt2">

                </TextView>

                <TextClock
                    android:id="@+id/Time1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:format12Hour="hh:mm:ss a MMM, dd yyyy"
                    android:layout_margin="10dp"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    app:layout_constraintTop_toBottomOf="@id/txt3">

                </TextClock>

                <ImageView
                    android:id="@+id/img2"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:scaleType="centerCrop"
                    android:background="@drawable/heart_animation_list"
                    android:layout_marginEnd="20dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/txt3"/>


                <Button
                    android:id="@+id/CreateAlarm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#82A7F5"
                    android:layout_marginTop="10dp"
                    android:drawableLeft="@drawable/baseline_alarm_add_24"
                    android:drawableTint="@color/white"
                    android:text="Create Alarm"
                    app:layout_constraintStart_toStartOf="@id/txt3"
                    app:layout_constraintTop_toBottomOf="@id/Time1">

                </Button>

                <Button
                    android:id="@+id/CancelAlarm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#82A7F5"
                    android:background="@android:color/transparent"
                    android:layout_marginTop="10dp"
                    android:drawableLeft="@drawable/baseline_alarm_off_24"
                    android:drawableTint="#82A7F5"
                    android:text="Cancel Alarm"
                    app:layout_constraintStart_toEndOf="@id/CreateAlarm"
                    app:layout_constraintTop_toBottomOf="@id/Time1">

                </Button>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>